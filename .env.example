# =============================================================================
# FireFeed - Environment Configuration Example
# =============================================================================
# Copy this file to .env and fill in your actual values
# The .env file should NOT be committed to version control

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
# PostgreSQL database host (default: localhost)
DB_HOST=localhost

# PostgreSQL database user (required)
DB_USER=your_db_user

# PostgreSQL database password (required)
DB_PASSWORD=your_secure_password

# PostgreSQL database name (required)
DB_NAME=firefeed

# PostgreSQL port (default: 5432)
DB_PORT=5432

# Minimum number of connections in the pool (default: 5)
DB_MINSIZE=5

# Maximum number of connections in the pool (default: 20)
DB_MAXSIZE=20

# -----------------------------------------------------------------------------
# Telegram Bot Configuration
# -----------------------------------------------------------------------------
# Telegram Bot Token from @BotFather (required)
# Get your bot token: https://t.me/BotFather
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# -----------------------------------------------------------------------------
# JWT Configuration
# -----------------------------------------------------------------------------
# Secret key for JWT token signing (required, minimum 32 characters)
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=your_jwt_secret_key_minimum_32_characters_long

# -----------------------------------------------------------------------------
# SMTP Email Configuration
# -----------------------------------------------------------------------------
# SMTP server address (required for email verification and password reset)
SMTP_SERVER=smtp.yourdomain.com

# SMTP port (default: 465 for SSL, use 587 for TLS)
SMTP_PORT=465

# SMTP email address (required)
SMTP_EMAIL=noreply@yourdomain.com

# SMTP password or app-specific password (required)
SMTP_PASSWORD=your_smtp_password

# Use TLS encryption (default: True)
# Set to True for port 587, False for port 465
SMTP_USE_TLS=True

# -----------------------------------------------------------------------------
# Webhook Configuration
# -----------------------------------------------------------------------------
# Webhook listener host (default: 127.0.0.1 for local development)
WEBHOOK_LISTEN=127.0.0.1

# Webhook port (default: 5000)
WEBHOOK_PORT=5000

# Webhook URL path (default: webhook)
WEBHOOK_URL_PATH=webhook

# Full webhook URL (required for production with HTTPS)
# Format: https://yourdomain.com/webhook
WEBHOOK_URL=https://yourdomain.com/webhook

# -----------------------------------------------------------------------------
# Logging Configuration
# -----------------------------------------------------------------------------
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL (default: INFO)
LOG_LEVEL=INFO
