# Исключаем ненужные файлы для сборки образа
.git
.gitignore
.env
__pycache__
*.pyc
*.pyo
*.pyd
.Python
env
venv
# Исключаем локальные виртуальные окружения - UV создаст свое окружение в контейнере
.venv
__pypackages__/
pip-log.txt
pip-delete-this-directory.txt
.tox
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.log
.mypy_cache
.pytest_cache
.hypothesis
# Исключаем директории с данными, если они не нужны в образе
data/
# Исключаем тесты, если не нужны в продакшене
test_*.py
tests/
# Исключаем скрипты запуска, если используем CMD в Dockerfile
run_*.sh
# Исключаем chrome-extension, если не нужна в контейнере
chrome-extension/

# Исключаем docker-compose файл
docker-compose.yml

# Исключаем документацию в формате Markdown
*.md
# IDE и агенты
.vscode/
.idea/
.trae/
.claude/
.windsurf/
.roo/
.cursor/
.kiro/
.qoder/
.augment/
